#pragma kernel BlendIrradiance
#pragma kernel BlendDistanceMoments

#define DDGI_GOLDEN_ANGLE 2.39996322972865332223
#define DDGI_IRRADIANCE_RESOLUTION 6
#define DDGI_IRRADIANCE_TILE_SIZE 8
#define DDGI_DISTANCE_RESOLUTION 14
#define DDGI_DISTANCE_TILE_SIZE 16

Texture2D<float4> _DDGI_RayPositionTexture;
Texture2D<float4> _DDGI_RayRadianceTexture;
Texture2D<float4> _DDGI_PreviousIrradianceAtlas;
Texture2D<float2> _DDGI_PreviousDistanceMomentsAtlas;
RWTexture2D<float4> _DDGI_IrradianceAtlas;
RWTexture2D<float2> _DDGI_DistanceMomentsAtlas;
StructuredBuffer<float3> _DDGI_ProbePositions;

uint _DDGI_ProbeCount;
uint _DDGI_RayCount;
uint _DDGI_AtlasTilesPerRow;
float _DDGI_MaxRayDistance;
float _DDGI_DistanceSharpness;
float4x4 _DDGI_RayRotation;
int _DDGI_HasBlendHistory;
float _DDGI_IrradianceHysteresis;
float _DDGI_DistanceHysteresis;
float _DDGI_TemporalGamma;

float SignNotZero(float value)
{
    return value >= 0.0 ? 1.0 : -1.0;
}

float3 DecodeOctahedralDirection(float2 encodedDirection)
{
    float3 direction = float3(
        encodedDirection.x,
        encodedDirection.y,
        1.0 - abs(encodedDirection.x) - abs(encodedDirection.y));

    if (direction.z < 0.0)
    {
        direction.xy = (1.0 - abs(direction.yx)) * float2(
            SignNotZero(direction.x),
            SignNotZero(direction.y));
    }

    return normalize(direction);
}

float3 GetOctahedralTexelDirection(uint2 interiorTexel, uint resolution)
{
    float2 uv = (float2(interiorTexel) + 0.5) / (float)resolution;
    return DecodeOctahedralDirection(uv * 2.0 - 1.0);
}

float3 FibonacciSphereDirection(uint rayIndex, uint rayCount)
{
    float sample = (rayIndex + 0.5) / rayCount;
    float cosTheta = 1.0 - 2.0 * sample;
    float sinTheta = sqrt(saturate(1.0 - cosTheta * cosTheta));
    float azimuth = DDGI_GOLDEN_ANGLE * rayIndex;
    float3 localDirection = float3(
        cos(azimuth) * sinTheta,
        sin(azimuth) * sinTheta,
        cosTheta);
    return normalize(mul((float3x3)_DDGI_RayRotation, localDirection));
}

uint GetProbeIndex(uint2 tileCoordinate)
{
    return tileCoordinate.x + tileCoordinate.y * _DDGI_AtlasTilesPerRow;
}

void FillIrradianceBorder(uint2 tileOrigin, uint2 tileTexel)
{
    const uint last = DDGI_IRRADIANCE_TILE_SIZE - 1;
    const uint interiorLast = DDGI_IRRADIANCE_RESOLUTION;
    uint2 destination = tileOrigin + tileTexel;
    uint2 source;

    if (tileTexel.x == 0 && tileTexel.y > 0 && tileTexel.y < last)
        source = tileOrigin + uint2(interiorLast, last - tileTexel.y);
    else if (tileTexel.x == last && tileTexel.y > 0 && tileTexel.y < last)
        source = tileOrigin + uint2(1, last - tileTexel.y);
    else if (tileTexel.y == 0 && tileTexel.x > 0 && tileTexel.x < last)
        source = tileOrigin + uint2(last - tileTexel.x, interiorLast);
    else if (tileTexel.y == last && tileTexel.x > 0 && tileTexel.x < last)
        source = tileOrigin + uint2(last - tileTexel.x, 1);
    else if (all(tileTexel == uint2(0, 0)))
        source = tileOrigin + uint2(interiorLast, interiorLast);
    else if (all(tileTexel == uint2(last, 0)))
        source = tileOrigin + uint2(1, interiorLast);
    else if (all(tileTexel == uint2(0, last)))
        source = tileOrigin + uint2(interiorLast, 1);
    else if (all(tileTexel == uint2(last, last)))
        source = tileOrigin + uint2(1, 1);
    else
        return;

    _DDGI_IrradianceAtlas[destination] = _DDGI_IrradianceAtlas[source];
}

void FillDistanceBorder(uint2 tileOrigin, uint2 tileTexel)
{
    const uint last = DDGI_DISTANCE_TILE_SIZE - 1;
    const uint interiorLast = DDGI_DISTANCE_RESOLUTION;
    uint2 destination = tileOrigin + tileTexel;
    uint2 source;

    if (tileTexel.x == 0 && tileTexel.y > 0 && tileTexel.y < last)
        source = tileOrigin + uint2(interiorLast, last - tileTexel.y);
    else if (tileTexel.x == last && tileTexel.y > 0 && tileTexel.y < last)
        source = tileOrigin + uint2(1, last - tileTexel.y);
    else if (tileTexel.y == 0 && tileTexel.x > 0 && tileTexel.x < last)
        source = tileOrigin + uint2(last - tileTexel.x, interiorLast);
    else if (tileTexel.y == last && tileTexel.x > 0 && tileTexel.x < last)
        source = tileOrigin + uint2(last - tileTexel.x, 1);
    else if (all(tileTexel == uint2(0, 0)))
        source = tileOrigin + uint2(interiorLast, interiorLast);
    else if (all(tileTexel == uint2(last, 0)))
        source = tileOrigin + uint2(1, interiorLast);
    else if (all(tileTexel == uint2(0, last)))
        source = tileOrigin + uint2(interiorLast, 1);
    else if (all(tileTexel == uint2(last, last)))
        source = tileOrigin + uint2(1, 1);
    else
        return;

    _DDGI_DistanceMomentsAtlas[destination] = _DDGI_DistanceMomentsAtlas[source];
}

[numthreads(DDGI_IRRADIANCE_TILE_SIZE, DDGI_IRRADIANCE_TILE_SIZE, 1)]
void BlendIrradiance(
    uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID)
{
    uint2 tileCoordinate = groupId.xy;
    uint probeIndex = GetProbeIndex(tileCoordinate);
    if (probeIndex >= _DDGI_ProbeCount)
        return;

    uint2 tileOrigin = tileCoordinate * DDGI_IRRADIANCE_TILE_SIZE;
    uint2 tileTexel = groupThreadId.xy;

    if (tileTexel.x < DDGI_IRRADIANCE_RESOLUTION &&
        tileTexel.y < DDGI_IRRADIANCE_RESOLUTION)
    {
        float3 texelDirection = GetOctahedralTexelDirection(
            tileTexel,
            DDGI_IRRADIANCE_RESOLUTION);
        float3 weightedRadiance = 0.0;
        float totalWeight = 0.0;

        for (uint rayIndex = 0; rayIndex < _DDGI_RayCount; ++rayIndex)
        {
            float3 rayDirection = FibonacciSphereDirection(rayIndex, _DDGI_RayCount);
            float weight = saturate(dot(texelDirection, rayDirection));
            float3 radiance = _DDGI_RayRadianceTexture.Load(
                int3(uint2(rayIndex, probeIndex), 0)).rgb;
            weightedRadiance += radiance * weight;
            totalWeight += weight;
        }

        uint2 destination = tileOrigin + tileTexel + 1;
        float3 irradiance = max(weightedRadiance / max(totalWeight, 1e-6), 0.0);
        if (_DDGI_HasBlendHistory != 0)
        {
            float3 previous = max(_DDGI_PreviousIrradianceAtlas.Load(int3(destination, 0)).rgb, 0.0);
            float inverseGamma = rcp(_DDGI_TemporalGamma);
            float3 encoded = lerp(
                pow(irradiance, inverseGamma),
                pow(previous, inverseGamma),
                _DDGI_IrradianceHysteresis);
            irradiance = pow(encoded, _DDGI_TemporalGamma);
        }
        _DDGI_IrradianceAtlas[destination] = float4(irradiance, 1.0);
    }

    DeviceMemoryBarrierWithGroupSync();
    FillIrradianceBorder(tileOrigin, tileTexel);
}

[numthreads(DDGI_DISTANCE_TILE_SIZE, DDGI_DISTANCE_TILE_SIZE, 1)]
void BlendDistanceMoments(
    uint3 groupId : SV_GroupID,
    uint3 groupThreadId : SV_GroupThreadID)
{
    uint2 tileCoordinate = groupId.xy;
    uint probeIndex = GetProbeIndex(tileCoordinate);
    if (probeIndex >= _DDGI_ProbeCount)
        return;

    uint2 tileOrigin = tileCoordinate * DDGI_DISTANCE_TILE_SIZE;
    uint2 tileTexel = groupThreadId.xy;

    if (tileTexel.x < DDGI_DISTANCE_RESOLUTION &&
        tileTexel.y < DDGI_DISTANCE_RESOLUTION)
    {
        float3 texelDirection = GetOctahedralTexelDirection(
            tileTexel,
            DDGI_DISTANCE_RESOLUTION);
        float weightedDistance = 0.0;
        float weightedDistanceSquared = 0.0;
        float totalWeight = 0.0;
        float3 probePosition = _DDGI_ProbePositions[probeIndex];

        for (uint rayIndex = 0; rayIndex < _DDGI_RayCount; ++rayIndex)
        {
            float3 rayDirection = FibonacciSphereDirection(rayIndex, _DDGI_RayCount);
            float cosine = saturate(dot(texelDirection, rayDirection));
            float weight = pow(cosine, _DDGI_DistanceSharpness);
            float4 positionSample = _DDGI_RayPositionTexture.Load(
                int3(uint2(rayIndex, probeIndex), 0));
            float distance = positionSample.a > 0.0
                ? length(positionSample.xyz - probePosition)
                : _DDGI_MaxRayDistance;

            weightedDistance += distance * weight;
            weightedDistanceSquared += distance * distance * weight;
            totalWeight += weight;
        }

        uint2 destination = tileOrigin + tileTexel + 1;
        float inverseWeight = rcp(max(totalWeight, 1e-6));
        float2 moments = float2(
            weightedDistance * inverseWeight,
            weightedDistanceSquared * inverseWeight);
        if (_DDGI_HasBlendHistory != 0)
        {
            float2 previous = _DDGI_PreviousDistanceMomentsAtlas.Load(int3(destination, 0));
            moments = lerp(moments, previous, _DDGI_DistanceHysteresis);
        }
        // Both raw moments use the same linear weights to preserve nonnegative variance.
        moments.y = max(moments.y, moments.x * moments.x);
        _DDGI_DistanceMomentsAtlas[destination] = moments;
    }

    DeviceMemoryBarrierWithGroupSync();
    FillDistanceBorder(tileOrigin, tileTexel);
}
