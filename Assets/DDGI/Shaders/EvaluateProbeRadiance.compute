#pragma kernel EvaluateRadiance

// Probe hits are in world space, so sample the light-space atlas rather than
// URP's camera-space screen shadow texture.
#define _MAIN_LIGHT_SHADOWS_CASCADE 1
#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Shadows.hlsl"
#define DDGI_SAMPLE_PREVIOUS_FRAME 1
#include "Assets/DDGI/Shaders/DDGIVolumeSampling.hlsl"

struct DDGILight
{
    float4 positionAndType;
    float4 directionAndRange;
    float4 color;
    float4 spotAngles;
};

Texture2D<float4> _DDGI_RayPositionTexture;
Texture2D<float4> _DDGI_RayNormalTexture;
Texture2D<float4> _DDGI_RayAlbedoTexture;
RWTexture2D<float4> _DDGI_RayRadianceTexture;
RWTexture2D<float> _DDGI_RayShadowVisibilityTexture;

StructuredBuffer<float3> _DDGI_ProbePositions;
StructuredBuffer<DDGILight> _DDGI_Lights;

uint _DDGI_LightCount;
float2 _DDGI_RayTextureSize;
float4 _DDGI_AmbientColor;
float _DDGI_DiffuseIntensity;
float4 _DDGI_SpecularColor;
float _DDGI_SpecularIntensity;
float _DDGI_Shininess;
int _DDGI_MainLightCascadeCount;
int _DDGI_HasPreviousVolume;
float _DDGI_IndirectBounceIntensity;

float EvaluateRangeAttenuation(float distanceSquared, float range)
{
    float rangeSquared = max(range * range, 1e-4);
    float smoothFactor = saturate(1.0 - distanceSquared / rangeSquared);
    return smoothFactor * smoothFactor / max(distanceSquared, 1.0);
}

float EvaluateSpotAttenuation(DDGILight light, float3 directionToLight)
{
    float cosine = dot(-directionToLight, normalize(light.directionAndRange.xyz));
    float attenuation = saturate((cosine - light.spotAngles.x) * light.spotAngles.y);
    return attenuation * attenuation;
}

[numthreads(8, 8, 1)]
void EvaluateRadiance(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 pixel = dispatchThreadId.xy;
    if (pixel.x >= (uint)_DDGI_RayTextureSize.x || pixel.y >= (uint)_DDGI_RayTextureSize.y)
        return;

    uint2 probeState = _DDGI_ProbeStates[pixel.y];
    if ((probeState.y & DDGI_PROBE_UPDATE) == 0) return;
    if (probeState.x == DDGI_PROBE_OFF)
    {
        _DDGI_RayRadianceTexture[pixel] = 0.0;
        _DDGI_RayShadowVisibilityTexture[pixel] = 0.0;
        return;
    }

    float4 positionSample = _DDGI_RayPositionTexture.Load(int3(pixel, 0));
    if (positionSample.a <= 0.0)
    {
        _DDGI_RayRadianceTexture[pixel] = 0.0;
        _DDGI_RayShadowVisibilityTexture[pixel] = 0.0;
        return;
    }

    float3 positionWS = positionSample.xyz;
    float3 normalWS = normalize(_DDGI_RayNormalTexture.Load(int3(pixel, 0)).xyz);
    float3 albedo = saturate(_DDGI_RayAlbedoTexture.Load(int3(pixel, 0)).rgb);
    float3 viewDirection = normalize(_DDGI_ProbePositions[pixel.y] - positionWS);
    float3 radiance = albedo * _DDGI_AmbientColor.rgb;
    float mainLightVisibility = 0.0;

    if (_DDGI_HasPreviousVolume != 0 && _DDGI_IndirectBounceIntensity > 0.0)
    {
        float3 previousIrradiance = DDGISampleIrradiance(
            positionWS, normalWS, viewDirection);
        radiance += albedo * previousIrradiance *
            (_DDGI_IndirectBounceIntensity / DDGI_PI);
    }

    for (uint lightIndex = 0; lightIndex < _DDGI_LightCount; ++lightIndex)
    {
        DDGILight light = _DDGI_Lights[lightIndex];
        uint lightType = (uint)light.positionAndType.w;
        float3 directionToLight;
        float attenuation = 1.0;

        if (lightType == 0)
        {
            directionToLight = normalize(-light.directionAndRange.xyz);
        }
        else
        {
            float3 toLight = light.positionAndType.xyz - positionWS;
            float distanceSquared = max(dot(toLight, toLight), 1e-6);
            directionToLight = toLight * rsqrt(distanceSquared);
            attenuation = EvaluateRangeAttenuation(distanceSquared, light.directionAndRange.w);

            if (lightType == 2)
                attenuation *= EvaluateSpotAttenuation(light, directionToLight);
        }

        float normalDotLight = saturate(dot(normalWS, directionToLight));
        if (normalDotLight <= 0.0 || attenuation <= 0.0)
        {
            if (light.spotAngles.z > 0.5)
                mainLightVisibility = 0.0;
            continue;
        }

        if (light.spotAngles.z > 0.5 && _DDGI_MainLightCascadeCount > 0)
        {
            float3 shadowPositionWS = positionWS + normalWS * 0.01;
            half cascadeIndex = ComputeCascadeIndex(shadowPositionWS);
            if (cascadeIndex >= _DDGI_MainLightCascadeCount)
            {
                mainLightVisibility = 0.0;
                continue;
            }
            mainLightVisibility = MainLightRealtimeShadow(
                TransformWorldToShadowCoord(shadowPositionWS));
            attenuation *= mainLightVisibility;
        }

        float3 halfDirection = normalize(directionToLight + viewDirection);
        float specularFactor = pow(saturate(dot(normalWS, halfDirection)), _DDGI_Shininess);
        float3 diffuse = albedo * normalDotLight * _DDGI_DiffuseIntensity;
        float3 specular = _DDGI_SpecularColor.rgb * specularFactor * _DDGI_SpecularIntensity;
        radiance += (diffuse + specular) * light.color.rgb * attenuation;
    }

    _DDGI_RayRadianceTexture[pixel] = float4(max(radiance, 0.0), 1.0);
    _DDGI_RayShadowVisibilityTexture[pixel] = mainLightVisibility;
}
